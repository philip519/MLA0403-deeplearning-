import numpy as np
import matplotlib.pyplot as plt
# Actual Parameters
true_mean = 50
true_std = 5
# Generate Synthetic Data
np.random.seed(42)
data = np.random.normal(true_mean, true_std, 1000)
# MLE Estimation
estimated_mean = np.mean(data)
estimated_variance = np.mean((data - estimated_mean) ** 2)
# Actual Variance
true_variance = true_std ** 2
# Display Results
print("Actual Mean:", true_mean)
print("Estimated Mean:", round(estimated_mean, 2))
print("Actual Variance:", true_variance)
print("Estimated Variance:", round(estimated_variance, 2))
# Plot Histogram
plt.figure(figsize=(6,4))
plt.hist(data, bins=30, edgecolor='black')
plt.title("Histogram of Synthetic Data")
plt.xlabel("Data Values")
plt.ylabel("Frequency")
plt.grid(True)
plt.show()
