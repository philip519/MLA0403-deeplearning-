import numpy as np
# Inputs
x = np.array([1.0, 2.0])
# Weights
w = np.array([0.5, -0.4])
# Bias
b = 0.2
# Sigmoid Function
def sigmoid(z):
return 1 / (1 + np.exp(-z))
# Forward Propagation
z = np.dot(x, w) + b
output = sigmoid(z)
print("Weighted Sum (z):", round(z, 3))
print("Network Output:", round(output, 3))
