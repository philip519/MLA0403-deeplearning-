from sklearn.datasets import make_regression
from sklearn.linear_model import LinearRegression, SGDRegressor
from sklearn.metrics import mean_squared_error
# Dataset
X, y = make_regression(n_samples=100,
n_features=1,
noise=10,
random_state=42)
# Batch Gradient Descent
batch_model = LinearRegression()
batch_model.fit(X, y)
batch_pred = batch_model.predict(X)
# Stochastic Gradient Descent
sgd_model = SGDRegressor(max_iter=1000,
learning_rate='constant',
eta0=0.01,
random_state=42)
sgd_model.fit(X, y)
sgd_pred = sgd_model.predict(X)
print("Batch GD MSE:",
round(mean_squared_error(y, batch_pred), 2))
print("SGD MSE:",
round(mean_squared_error(y, sgd_pred), 2))
