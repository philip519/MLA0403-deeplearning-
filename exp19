Age <- c(21,25,30,35,40,45,50,55,60,65)
BloodPressure <- c(72,75,78,80,82,85,88,90,93,95)

model <- lm(BloodPressure ~ Age)

plot(Age,
     BloodPressure,
     col="green",
     pch=19,
     main="Linear Regression",
     xlab="Age",
     ylab="Blood Pressure")

abline(model, col="red")

summary(model)